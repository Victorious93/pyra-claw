<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mDNS hub discovery (NsdManager) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Background hub link with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- One of the prerequisites Android 14 requires for the connectedDevice FGS type -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Settings > "Allow background" shortcut (sideloaded fleet app) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <permission
        android:name="com.victorious.pyraclaw.permission.EXTERNAL_NODE"
        android:protectionLevel="signature" />

    <application
        android:name=".PyraApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PyraClaw">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PyraClaw.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".service.HubConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync" />
        <receiver
            android:name=".fleet.ExternalNodeReceiver"
            android:exported="true"
            android:permission="com.victorious.pyraclaw.permission.EXTERNAL_NODE">
            <intent-filter>
                <action android:name="ai.droidcommand.action.REMOTE_COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
