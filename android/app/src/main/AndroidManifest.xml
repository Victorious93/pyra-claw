<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v0.3 Timer tab: foreground hub link with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- One of the prerequisites Android 14 requires for the connectedDevice FGS type -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <permission
        android:name="com.victorious.pyraclaw.permission.EXTERNAL_NODE"
        android:protectionLevel="signature" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".service.HubConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync" />
        <receiver
            android:name=".fleet.ExternalNodeReceiver"
            android:exported="true"
            android:permission="com.victorious.pyraclaw.permission.EXTERNAL_NODE">
            <intent-filter>
                <action android:name="ai.droidcommand.action.REMOTE_COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
